# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Sessions ---
# Signs the login session cookie (see src/lib/session.ts). Any long random
# string — generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Supabase (Project Settings -> API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=
# Supabase's newer dashboards call this the "Publishable key" (sb_publishable_...)
# — same slot as the older "anon key", just renamed.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Called "Secret key" (sb_secret_...) in newer dashboards, "service_role key"
# in older ones. Server-only, bypasses RLS — this app uses it for every
# authenticated read/write, scoping access in application code instead of
# RLS (see src/lib/profile.ts and supabase/migrations/0001_init.sql).
SUPABASE_SERVICE_ROLE_KEY=

# --- Moyasar (https://dashboard.moyasar.com) ---
MOYASAR_SECRET_KEY=
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=
# Set after creating the webhook in the Moyasar dashboard; used to verify
# incoming webhook signatures.
MOYASAR_WEBHOOK_SECRET=

# --- Google Sheets sync ---
# Create a Google Cloud service account, enable the Sheets API, share the
# target sheet with the service account's email as an Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the service account private key. Keep the literal \n escapes.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEET_ID=
# Secret shared with Vercel Cron so /api/cron/sync-sheet can't be called by anyone else.
CRON_SECRET=

# --- Mapbox (https://account.mapbox.com) ---
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Telegram order notifications ---
# Create a bot via @BotFather on Telegram to get a token, then message the
# bot once and look up your chat ID at
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
