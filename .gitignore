# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# Google Cloud service account keys (downloaded JSON credentials) — never commit these.
# The values already live in .env.local; keep any future downloaded key files
# outside this folder, or name them so this pattern catches them.
*.serviceaccount.json
aquashop-506912-66a472e56d33.json

# typescript
*.tsbuildinfo
next-env.d.ts
